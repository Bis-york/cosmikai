
# --- Required service URLs ---
VITE_API_BASE_URL=api.flyingwaffle.ca  # add your api domain here
VITE_VISUAL_BASE_URL=visuals.flyingwaffle.ca  # add your visual domain here

# --- Vite dev server --- 
VITE_HOST=0.0.0.0 
VITE_PORT=5180 V
ITE_STRICT_PORT=true 
VITE_HTTPS=false 
VITE_OPEN=false

# --- Vite preview server --- V
ITE_PREVIEW_HOST=0.0.0.0 
VITE_PREVIEW_PORT=5280

# --- CORS for Vite dev server (optional) --- 
# add your domains for the base and the visual server here
VITE_ALLOWED_ORIGINS=cosmikai.flyingwaffle.ca,visuals.flyingwaffle.ca

# --- Base path if served behind a subpath (optional) --- 
VITE_BASE=/