# Backend configuration for FastAPI CORS, make sure to add all 3 URLs


COSMIKAI_CORS_ORIGINS=cosmikai.flyingwaffle.ca,https://visuals.flyingwaffle.ca,https://api.flyingwaffle.ca

#^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
#make sure to uncommment the middle code and replace with your actual deployed domain URLs


COSMIKAI_MONGO_URI=mongodb://localhost:27017/      #change the mongo URI if needed
COSMIKAI_MONGO_DB=exoplanet_DB                     #the default database name
COSMIKAI_MONGO_COLLECTION=predictions              #default collection name for predictions